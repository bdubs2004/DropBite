{
  "expo": {
    "name": "NiblGo",
    "slug": "niblgo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "niblgo",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.niblgo.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:niblgo.com"],
      "infoPlist": {
        "NSCameraUsageDescription": "NiblGo uses your camera so you can snap a photo of your meal.",
        "NSPhotoLibraryUsageDescription": "NiblGo lets you pick a meal photo from your library."
      }
    },
    "android": {
      "package": "com.niblgo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEF7ED",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "niblgo.com", "pathPrefix": "/auth/confirm" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#E8862E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF4DE"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NiblGo lets you pick a meal photo from your library.",
          "cameraPermission": "NiblGo uses your camera so you can snap a photo of your meal."
        }
      ],
      "expo-image",
      "expo-status-bar"
    ]
  }
}
