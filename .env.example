# Copy to .env and fill in to leave demo mode and go live.
# All EXPO_PUBLIC_* vars are baked into the app bundle, so they are safe for publishable
# keys only (Supabase anon key: yes; Anthropic key: NEVER, that one goes in
# the Supabase Edge Function secret instead).

# --- Supabase (required to leave demo mode) --------------------------------
# Project dashboard → Settings → API.
#
# NOTE the EXPO_PUBLIC_ prefix. Supabase's dashboard shows these named
# NEXT_PUBLIC_* because it assumes a Next.js app; Expo only exposes vars
# prefixed EXPO_PUBLIC_ to the bundle, so copying those names verbatim leaves
# the app in demo mode with no error to tell you why.
#
# Either key format works in ANON_KEY: the legacy JWT ("eyJ...") or the newer
# publishable key ("sb_publishable_..."). Both are meant to be public.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Places (restaurant tagging) — DEFERRED to Phase 2 --------------
# Location / "where you ate" tagging is turned OFF for the MVP
# (LOCATION_TAGGING_ENABLED = false in src/config.ts). You do NOT need this key
# to launch. When you re-enable the feature, flip that flag and set the key:
# console.cloud.google.com → enable "Places API (New)" → create API key
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# --- Deep links (shared post links) -----------------------------------------
# Base URL for links shared out of the app. For https links to OPEN THE APP you
# must also host the platform association files on this domain — see
# SETUP_GUIDE.md B4. The niblgo:// scheme works without any of this.
EXPO_PUBLIC_APP_LINK_BASE=

# --- Anthropic (AI recipe cards) --------------------------------------------
# Do NOT put the key here. Set it server-side:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-your-key
#   supabase functions deploy format-recipe
#
# Optional edge-function secrets (see SECURITY.md):
#   supabase secrets set AI_DAILY_LIMIT=40
#   supabase secrets set ALLOWED_ORIGINS=https://yourdomain.com
