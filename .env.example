# Copy to .env and fill in to leave demo mode and go live.
# All EXPO_PUBLIC_* vars are baked into the app bundle, so they are safe for publishable
# keys only (Supabase anon key: yes; Anthropic key: NEVER, that one goes in
# the Supabase Edge Function secret instead).

# --- Supabase (required to leave demo mode) --------------------------------
# Project dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Places (restaurant tagging) — DEFERRED to Phase 2 --------------
# Location / "where you ate" tagging is turned OFF for the MVP
# (LOCATION_TAGGING_ENABLED = false in src/config.ts). You do NOT need this key
# to launch. When you re-enable the feature, flip that flag and set the key:
# console.cloud.google.com → enable "Places API (New)" → create API key
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# --- Anthropic (AI recipe cards) --------------------------------------------
# Do NOT put the key here. Set it server-side:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-your-key
#   supabase functions deploy format-recipe
